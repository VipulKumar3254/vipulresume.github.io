rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{messageId} {
      function isValidContactMessage() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'source'])
          && data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'source'])
          && data.name is string
          && data.name.size() >= 1
          && data.name.size() <= 100
          && data.email is string
          && data.email.size() >= 3
          && data.email.size() <= 254
          && data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
          && data.message is string
          && data.message.size() >= 1
          && data.message.size() <= 5000
          && data.createdAt == request.time
          && data.source == 'portfolio-contact';
      }

      allow create: if isValidContactMessage();
      allow get, list, update, delete: if false;
    }
  }
}
